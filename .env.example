APP_NAME=PlayBossAPI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/playboss-casino-api/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=dev_playboss
DB_USERNAME=root
DB_PASSWORD=

# Dedicated MySQL connection settings (fall back to DB_* for older .env files)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=dev_playboss
MYSQL_USERNAME=root
MYSQL_PASSWORD=
# Nube: MYSQL_URL=mysql://usuario:clave@host:puerto/base (sustituye host/usuario/etc.)
MYSQL_URL=
# Nube: ruta al CA (ej. /etc/ssl/certs/ca-certificates.crt) y true para validar el certificado
MYSQL_ATTR_SSL_CA=
MYSQL_ATTR_SSL_VERIFY=
MYSQL_CONNECT_TIMEOUT=10

# Additional relational database connections
SQLSERVER_URL=
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=playboss
SQLSERVER_USERNAME=
SQLSERVER_PASSWORD=
SQLSERVER_CHARSET=utf8
SQLSERVER_ENCRYPT=yes
SQLSERVER_TRUST_SERVER_CERTIFICATE=false
SQLSERVER_LOGIN_TIMEOUT=15

POSTGRES_URL=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=playboss
POSTGRES_USERNAME=
POSTGRES_PASSWORD=
POSTGRES_CHARSET=utf8
POSTGRES_SSLMODE=prefer
# Nube: POSTGRES_SSLMODE=require (o verify-full + POSTGRES_SSLROOTCERT=/etc/ssl/certs/ca-certificates.crt)
POSTGRES_SSLROOTCERT=
POSTGRES_CONNECT_TIMEOUT=10

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=playboss
# Nube (Atlas): MONGODB_URI=mongodb+srv://usuario:clave@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_APP_NAME="${APP_NAME}"

# Firebase Firestore service account JSON file; keep credentials out of git.
FIREBASE_CREDENTIALS=storage/app/private/firebase/service-account.json
FIREBASE_PROJECT_ID=
FIREBASE_FIRESTORE_DATABASE=(default)
# Driver de pagos: wompi | firebase_function
PAYMENT_GATEWAY_DRIVER=wompi
PAYMENT_METHOD_CODE=WOMPI
FIREBASE_PAYMENT_FUNCTION_URL=
FIREBASE_PAYMENT_FUNCTION_TOKEN=
PAYMENT_MINIMUM_AMOUNT_MINOR=100

# Wompi (sandbox). Llaves en https://comercios.wompi.co > Desarrolladores. Nunca subas valores reales a Git.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_REDIRECT_URL=http://localhost:5173/billetera/recarga/resultado
# WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
# Minutos de vigencia del link de pago (expiration-time firmado); 0 = sin expiración.
WOMPI_EXPIRATION_MINUTES=60

# CORS: origenes del front separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Limites de apuestas
BET_MAX_SELECTIONS=10
BET_MIN_AGE=18
BET_DAILY_STAKE_LIMIT=5000000.00
BET_DAILY_COUNT_LIMIT=100
BET_MIN_STAKE=1000.00
BET_MAX_STAKE=2000000.00
DEPOSIT_MAX_AMOUNT=10000000.00
WITHDRAWAL_MIN_AMOUNT=10000.00
WITHDRAWAL_MAX_AMOUNT=5000000.00
WITHDRAWAL_MAX_PENDING=3
# Destino del formulario POST /contacto (por defecto MAIL_FROM_ADDRESS)
CONTACT_TO_ADDRESS=

# Swagger UI (/api/documentation) y spec (/api/openapi.json). Si se omite: true solo con APP_ENV=local.
# Usa false en producción si no quieres exponer la documentación (responde 404).
API_DOCS_ENABLED=true

# Google Drive service account JSON file and shared destination folder.
GOOGLE_DRIVE_CREDENTIALS=storage/app/private/google-drive/service-account.json
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_SHARED_DRIVE_ID=
# Modo OAuth (Gmail personal): GOOGLE_DRIVE_CREDENTIALS apunta al cliente OAuth y el token sale de php artisan playboss:drive-token
GOOGLE_DRIVE_REFRESH_TOKEN=

# reCAPTCHA v3 (login, registro, recuperar y restablecer). false por defecto: en local/tests no se exige.
# Con true, el front debe enviar recaptcha_token y Google debe responder (falla cerrada: 502).
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5

# Inicio de sesion con Google: ID de cliente OAuth web (el mismo que VITE_GOOGLE_CLIENT_ID del front). Sin secreto.
GOOGLE_CLIENT_ID=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Autenticación en dos pasos (TOTP) ---
# MFA_ENABLED=false apaga el 2FA por completo (interruptor de emergencia; no pide código ni siquiera a quien ya lo tiene).
MFA_ENABLED=true
MFA_ISSUER=PlayBoss
# Roles que NO pueden usar /admin/* ni retirar sin 2FA activo (separados por coma).
MFA_REQUIRED_ROLES=ADMIN
