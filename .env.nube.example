# =============================================================================
# PlayBoss API — conexiones a la NUBE
# Copia este archivo como .env.nube (está en .gitignore) y llena los datos.
#   - Desde tu PC:  php artisan playboss:migrate --env=nube   (crea las tablas en la nube)
#                   php artisan playboss:copiar-a-nube        (copia los datos locales)
#   - En Render:    las mismas variables van en Environment (ver docs/DESPLIEGUE-NUBE.md)
# =============================================================================
APP_NAME=PlayBossAPI
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://playboss-api.onrender.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stderr
LOG_SINGLE_PATH=php://stderr
LOG_LEVEL=info

# Conexión por defecto de Laravel (catálogo deportivo)
DB_CONNECTION=mysql

# --- MySQL: Aiven (Service > Overview > Connection information) ------------
MYSQL_HOST=xxxx.aivencloud.com
MYSQL_PORT=12345
MYSQL_DATABASE=defaultdb
MYSQL_USERNAME=avnadmin
MYSQL_PASSWORD=
# Certificado CA de Aiven (botón "CA certificate" > descargar como ca.pem)
#   PC:     storage/app/private/nube/aiven-ca.pem
#   Render: /etc/secrets/aiven-ca.pem
MYSQL_ATTR_SSL_CA=storage/app/private/nube/aiven-ca.pem

# --- PostgreSQL: Neon (Dashboard > Connect > Parameters only) --------------
POSTGRES_HOST=ep-xxxx.us-east-2.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_DATABASE=playboss
POSTGRES_USERNAME=playboss_owner
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require

# --- SQL Server: Azure SQL Database ----------------------------------------
SQLSERVER_HOST=playboss-sql.database.windows.net
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=playboss
SQLSERVER_USERNAME=playbossadmin
SQLSERVER_PASSWORD=
SQLSERVER_ENCRYPT=yes
SQLSERVER_TRUST_SERVER_CERTIFICATE=false

# --- MongoDB: Atlas (Connect > Drivers > cadena mongodb+srv) ---------------
MONGODB_URI="mongodb+srv://playboss:CLAVE@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DATABASE=playboss

# --- Firebase y Google Drive (los mismos de tu .env local) -----------------
#   PC:     storage/app/private/...   Render: /etc/secrets/...
FIREBASE_CREDENTIALS=storage/app/private/firebase/service-account.json
FIREBASE_PROJECT_ID=playboss-7d872
FIREBASE_FIRESTORE_DATABASE=(default)
GOOGLE_DRIVE_CREDENTIALS=storage/app/private/google-drive/oauth-client.json
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_REFRESH_TOKEN=

# --- Front desplegado (Vercel) ---------------------------------------------
CORS_ALLOWED_ORIGINS=https://playboss-casino.vercel.app
WOMPI_REDIRECT_URL=https://playboss-casino.vercel.app/billetera/recarga/resultado

# --- Pagos (copiar de tu .env local) ---------------------------------------
PAYMENT_GATEWAY_DRIVER=wompi
PAYMENT_METHOD_CODE=WOMPI
PAYMENT_MINIMUM_AMOUNT_MINOR=100
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
WOMPI_BASE_URL=https://sandbox.wompi.co/v1

API_DOCS_ENABLED=true

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
